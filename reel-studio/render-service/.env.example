# Random long secret; the same value goes into n8n (REEL settings) as the render key.
REEL_RENDER_API_KEY=change-me-to-a-long-random-string
# Same OpenRouter key n8n uses (needed to download generated clips and voice-over).
OPENROUTER_API_KEY=sk-or-...
# Public address of this service (domain behind your reverse proxy, or http://SERVER_IP:3900).
REEL_PUBLIC_URL=https://reels.example.com
